{
  "configurations": [
    {
      "browse": {
        "databaseFilename": "${default}",
        "limitSymbolsToIncludedHeaders": false
      },
      "includePath": [
        "/usr/include/**",
        "/opt/ros/noetic/include/**",
        "${workspaceFolder}/slam_toolbox/include/**",
        "${workspaceFolder}/slam_toolbox/lib/karto_sdk/include/**"
      ],
      "name": "ROS",
      "intelliSenseMode": "gcc-x64",
      "compilerPath": "/usr/bin/gcc",
      "cStandard": "c17",
      "cppStandard": "c++20"
    }
  ],
  "version": 4
}